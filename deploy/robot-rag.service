[Unit]
Description=Robot RAG customer service API
After=network-online.target postgresql@17-main.service
Wants=network-online.target
Requires=postgresql@17-main.service

[Service]
Type=simple
User=robot-rag
Group=robot-rag
WorkingDirectory=/opt/robot-rag-customer-service/current
EnvironmentFile=/etc/robot-rag.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/robot-rag-customer-service/venv-pgvector/bin/python -m uvicorn api:app --host 127.0.0.1 --port 8100 --workers 1 --no-server-header
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/robot-rag
UMask=0077
MemoryMax=1G
MemorySwapMax=512M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
