# DashScope API key used by DashScopeEmbeddings and ChatTongyi.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Production uses a dedicated DB role on the local 1Panel PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://robot-rag:your_database_password_here@127.0.0.1:5432/robot_rag
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=qwen3-max
