# DashScope API key used by DashScopeEmbeddings and ChatTongyi.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Production uses peer authentication for the dedicated robot-rag OS/DB user.
DATABASE_URL=postgresql+psycopg://robot-rag@/robot_rag?host=/var/run/postgresql
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=qwen3-max
