# DashScope API key used by DashScopeEmbeddings and ChatTongyi.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Development uses a separate role/database, never the old production DB.
DATABASE_URL=postgresql+psycopg://robot_rag_internal_dev:your_database_password_here@127.0.0.1:5432/robot_rag_internal_dev
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=qwen-plus

# Optional: administrator-maintained TXT folder; defaults to repository knowledge/robot.
# RAG_KNOWLEDGE_DIR=/home/ubuntu/robot-rag-dev/knowledge/robot
# Runtime history folder. Use a separate writable development directory.
# RAG_DATA_DIR=/home/ubuntu/robot-rag-dev/runtime
